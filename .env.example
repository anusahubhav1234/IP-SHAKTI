# Copy to .env (backend reads backend/.env; docker-compose reads this file at repo root)
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://sakti:sakti@localhost:5432/sakti
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT=10/minute
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=intfloat/multilingual-e5-small
MAX_UPLOAD_MB=20
OCR_ENABLED=true
# Get a free key at https://aistudio.google.com/apikey, then run: python -m app.scripts.check_llm
GEMINI_API_KEY=
# Model IDs change often. Pick one from the check_llm list (Flash-class models have free tiers).
GEMINI_MODEL=gemini-flash-latest
# Leave empty until calibrated on the real embedding model (Phase 7)
# MIN_EVIDENCE_SIMILARITY=
# Used by docker-compose's database service
POSTGRES_USER=sakti
POSTGRES_PASSWORD=sakti
POSTGRES_DB=sakti
